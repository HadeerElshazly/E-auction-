<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EAuction.Smoke</RootNamespace>
    <AssemblyName>EAuction.Smoke</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The frame codec is shared with the services deliberately: a smoke test that
         reimplemented it would pass while the real client failed. -->
    <ProjectReference Include="../../src/EAuction.Core/EAuction.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.6.0" />
  </ItemGroup>

</Project>
