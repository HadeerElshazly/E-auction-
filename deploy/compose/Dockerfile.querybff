# Public read model.
#
# Runs as a non-root user with an explicit UID, like every other image here
# (docs/ARCHITECTURE.md §10.1).

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY src/EAuction.Core/EAuction.Core.csproj src/EAuction.Core/
COPY src/EAuction.Security/EAuction.Security.csproj src/EAuction.Security/
COPY src/EAuction.QueryBff/EAuction.QueryBff.csproj src/EAuction.QueryBff/
RUN dotnet restore src/EAuction.QueryBff/EAuction.QueryBff.csproj
COPY src/ src/
RUN dotnet publish src/EAuction.QueryBff/EAuction.QueryBff.csproj \
      -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app .

RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin eauction
USER 10001

EXPOSE 8080
ENTRYPOINT ["./EAuction.QueryBff"]
