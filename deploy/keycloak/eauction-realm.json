{
  "realm": "eauction",
  "enabled": true,
  "displayName": "E-Auction",
  "displayNameHtml": "<b>المزاد الإلكتروني</b>",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ar",
    "en"
  ],
  "defaultLocale": "ar",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "refreshTokenMaxReuse": 0,
  "revokeRefreshToken": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "failureFactor": 10,
  "roles": {
    "realm": [
      {
        "name": "bidder",
        "description": "مزايد — a Nafath-verified individual who may bid"
      },
      {
        "name": "auction-admin",
        "description": "مدير النظام — prepares auctions, documents, dates"
      },
      {
        "name": "award-committee",
        "description": "ممثل لجنة الترسية — approves auctions and confirms awards"
      },
      {
        "name": "operator",
        "description": "Floor operator entering bids for an on-site auction"
      },
      {
        "name": "reporting",
        "description": "مسؤول التقارير — reads التقارير and cannot touch an auction. Exists so the municipality's finance staff do not need auction-admin, which can change a reserve price."
      },
      {
        "name": "auditor",
        "description": "مراجع — reads the staff audit trail, and nothing else. Deliberately held by nobody who operates the platform: an auditor who could also approve an auction would be reading their own record."
      }
    ]
  },
  "clients": [
    {
      "clientId": "bidder-web",
      "name": "Bidder portal (React)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "https://mazad.jeddah.gov.sa/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "eauction-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "eauction",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "national-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "national_id",
            "claim.name": "national_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "name-ar",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "name_ar",
            "claim.name": "name_ar",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "bidder-mobile",
      "name": "Bidder mobile app (React Native)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "eauction://callback",
        "http://localhost:19006/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "eauction-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "eauction",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "national-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "national_id",
            "claim.name": "national_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "name-ar",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "name_ar",
            "claim.name": "name_ar",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "admin-web",
      "name": "Administration and committee portal (React)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3001/*",
        "https://mazad-admin.jeddah.gov.sa/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "eauction-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "eauction",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
