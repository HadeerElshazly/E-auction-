<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EAuction.Documents</RootNamespace>
    <AssemblyName>EAuction.Documents</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../EAuction.Core/EAuction.Core.csproj" />
    <ProjectReference Include="../EAuction.Security/EAuction.Security.csproj" />
    <!-- For StaffActionRecorded alone. This service has no outbox and no
         database, so it publishes its own audit records straight onto the topic
         (§34) and uses nothing else from here.

         It does pick up EF Core Relational transitively and never loads it. The
         alternative is a second copy of the event contract, which is the drift
         the shared type exists to prevent — see the note on StaffAuditOutbox. -->
    <ProjectReference Include="../EAuction.Outbox/EAuction.Outbox.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- S3, because MinIO speaks it. The deployed object store may well not be
         MinIO — the on-prem environment is not yet known — and anything that
         speaks S3 drops in behind the same client. -->
    <PackageReference Include="AWSSDK.S3" Version="3.7.405.3" />
  </ItemGroup>

</Project>
